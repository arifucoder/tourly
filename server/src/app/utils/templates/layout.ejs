<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<meta name="supported-color-schemes" content="light" />
		<title><%= title %></title>
		<style>
			@media only screen and (max-width: 620px) {
				.outer { padding: 12px 8px !important; }
				.px { padding-left: 22px !important; padding-right: 22px !important; }
				.hide-mobile { display: none !important; }
				.h1 { font-size: 23px !important; line-height: 30px !important; }
				.code { font-size: 32px !important; line-height: 40px !important; letter-spacing: 6px !important; padding-left: 6px !important; }
				.stack td { display: block !important; width: 100% !important; padding: 0 0 10px 0 !important; }
			}
		</style>
	</head>
	<body style="margin: 0; padding: 0; background-color: #fff7f2">
		<div style="display: none; max-height: 0; overflow: hidden; opacity: 0"><%= previewText %></div>

		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #fff7f2">
			<tr>
				<td align="center" class="outer" style="padding: 32px 12px">
					<table
						role="presentation"
						width="600"
						cellpadding="0"
						cellspacing="0"
						border="0"
						style="width: 100%; max-width: 600px; background-color: #ffffff; border-radius: 14px; border-collapse: separate; box-shadow: 0 20px 44px rgba(45, 49, 52, 0.08)"
					>
						<tr>
							<td height="5" style="height: 5px; line-height: 5px; font-size: 0; background-color: #ff7b29; border-radius: 14px 14px 0 0">&nbsp;</td>
						</tr>

						<tr>
							<td class="px" style="padding: 22px 40px; border-bottom: 1px solid #eeeeee">
								<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
									<tr>
										<td>
											<a href="<%= frontendUrl %>" style="text-decoration: none">
												<table role="presentation" cellpadding="0" cellspacing="0" border="0">
													<tr>
														<td
															width="32"
															height="32"
															align="center"
															valign="middle"
															style="width: 32px; height: 32px; border-radius: 16px; background-color: #f26a1b; font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 32px; color: #ffffff"
														>
															&#10148;
														</td>
														<td style="padding-left: 10px; font-family: Arial, Helvetica, sans-serif; font-size: 21px; font-weight: bold; letter-spacing: -0.3px; color: #2d3134">
															tourly<span style="color: #ff7b29">.</span>
														</td>
													</tr>
												</table>
											</a>
										</td>
										<td
											align="right"
											class="hide-mobile"
											style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; color: #c2410c; white-space: nowrap"
										>
											Guided tours across Bangladesh
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<tr>
							<td class="px" style="padding: 36px 40px 34px 40px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 24px; color: #4a4e51">
								<%- bodyHtml %>
							</td>
						</tr>

						<tr>
							<td
								class="px"
								style="padding: 24px 40px; background-color: #fff7f2; border-top: 1px solid #f3e6dc; border-radius: 0 0 14px 14px; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 20px; color: #676a6c"
							>
								Questions about a trip? Write to
								<a href="mailto:<%= supportEmail %>" style="color: #c2410c; font-weight: bold; text-decoration: none"><%= supportEmail %></a>
								&mdash; we reply within a day.<br />
								<a href="<%= frontendUrl %>/help" style="color: #676a6c">Help centre</a> &middot;
								<a href="<%= frontendUrl %>/cancellation-policy" style="color: #676a6c">Cancellation policy</a> &middot;
								<a href="<%= frontendUrl %>/terms" style="color: #676a6c">Terms &amp; privacy</a><br />
								<span style="font-size: 12px; color: #9a9da0">This is an automated message from Tourly. Please don't reply to it directly.</span>
							</td>
						</tr>
					</table>

					<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px">
						<tr>
							<td align="center" style="padding: 20px 12px; font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #9a9da0">
								&copy; <%= year %> Tourly &middot; Prices in Bangladeshi Taka (BDT)
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
