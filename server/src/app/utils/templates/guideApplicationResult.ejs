<% if (approved) { %>
<div style="display: inline-block; margin: 0 0 14px 0; padding: 4px 12px; border-radius: 999px; background-color: #e2f3ea; font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; color: #1e7a4b">
	&#10003; Application approved
</div>
<h1 class="h1" style="margin: 0 0 12px 0; font-family: Arial, Helvetica, sans-serif; font-size: 26px; line-height: 32px; font-weight: bold; color: #2d3134">
	Welcome aboard, <%= name %>!
</h1>
<p style="margin: 0 0 24px 0">
	Your application to guide tours in <strong style="color: #2d3134"><%= divisionName %></strong> has been approved. You're
	now a Tourly guide.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: separate">
	<tr>
		<td style="padding: 20px 24px; background-color: #fff1e8; border: 1px solid #ffd2b5; border-radius: 12px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 23px; color: #2d3134">
			<div style="font-size: 12px; font-weight: bold; letter-spacing: 2px; color: #c2410c; padding-bottom: 6px">WHAT HAPPENS NEXT</div>
			&#8226;&nbsp; Admins assign you to paid bookings in your division.<br />
			&#8226;&nbsp; Each trip shows the travellers, dates and contact details in your guide dashboard.<br />
			&#8226;&nbsp; Keep your phone number up to date in your profile &mdash; travellers use it to reach you.
		</td>
	</tr>
</table>
<% } else { %>
<h1 class="h1" style="margin: 0 0 12px 0; font-family: Arial, Helvetica, sans-serif; font-size: 26px; line-height: 32px; font-weight: bold; color: #2d3134">
	About your guide application
</h1>
<p style="margin: 0 0 20px 0">
	Hi <%= name %>, thank you for applying to guide tours in <strong style="color: #2d3134"><%= divisionName %></strong>.
	After reviewing it, we can't approve your application right now.
</p>
<p style="margin: 0">You're welcome to apply again later &mdash; more local experience usually makes the difference.</p>
<% } %>

<% if (reviewNote) { %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 20px; border-collapse: separate">
	<tr>
		<td style="padding: 14px 16px; background-color: #f7f7f7; border-left: 3px solid #ff7b29; border-radius: 6px; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 21px; color: #4a4e51">
			<strong style="color: #2d3134">Note from our team:</strong> <%= reviewNote %>
		</td>
	</tr>
</table>
<% } %>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 26px 0 0 0">
	<tr>
		<td style="background-color: #ff7b29; border-radius: 8px">
			<a
				href="<%= dashboardUrl %>"
				style="display: inline-block; padding: 13px 26px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; font-weight: bold; color: #ffffff; text-decoration: none"
				><%= approved ? "Open guide dashboard" : "Go to my account" %></a
			>
		</td>
	</tr>
</table>
