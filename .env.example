# Root .env — used only by docker-compose.yml (app secrets live in server/.env)

# Password for the Redis container. server/.env REDIS_PASSWORD must match it
# when you run `pnpm dev` outside Docker. Generate: openssl rand -hex 24
REDIS_PASSWORD=change_me

# Host ports
REDIS_PORT=6379
API_PORT=5000
WEB_PORT=5173

# API URL baked into the client build (what the browser calls)
VITE_BASE_URL=http://localhost:5000/api/v1
