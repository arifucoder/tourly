# Production env for the api container. Copy to .env.api on the VPS and fill in.
# Replace tourly.dev.cv with your domain everywhere.
NODE_ENV=production
PORT=5000
# Cloudflare → host nginx → api
TRUST_PROXY_HOPS=2
FRONTEND_URL=https://tourly.dev.cv

# user/password = MONGO_INITDB_ROOT_* from .env.db
DB_URL=mongodb://tourly:change_me@mongo:27017/tourly?authSource=admin&replicaSet=rs0

# openssl rand -base64 32 (access and refresh must differ)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30d
BCRYPT_SALT_ROUND=10

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://tourly.dev.cv/api/v1/auth/google/callback

SSL_STORE_ID=
SSL_STORE_PASS=
SSL_PAYMENT_API=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSL_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSL_IPN_URL=https://tourly.dev.cv/api/v1/payment/validate-payment
SSL_SUCCESS_BACKEND_URL=https://tourly.dev.cv/api/v1/payment/success
SSL_FAIL_BACKEND_URL=https://tourly.dev.cv/api/v1/payment/fail
SSL_CANCEL_BACKEND_URL=https://tourly.dev.cv/api/v1/payment/cancel
SSL_SUCCESS_FRONTEND_URL=https://tourly.dev.cv/payment/success
SSL_FAIL_FRONTEND_URL=https://tourly.dev.cv/payment/fail
SSL_CANCEL_FRONTEND_URL=https://tourly.dev.cv/payment/cancel

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# the redis container (password = .env.db REDIS_PASSWORD)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me

TOUR_ROLLOVER_ENABLED=true
TOUR_ROLLOVER_CHECK_HOURS=6
TOUR_ROLLOVER_LEAD_DAYS=3
TOUR_ROLLOVER_SPREAD_DAYS=21
SEED_DEMO_PASSWORD=Tourly@2026
